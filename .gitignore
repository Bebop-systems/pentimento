# Vendored ExifTool binary (fetched by scripts/fetch_exiftool.py)
vendor/

# Sample photos carry real metadata (GPS, serials) - keep them out of history
*.HEIC
*.heic
*.jpg
*.jpeg
*.png
*.tiff
*.mov
*.mp4
!web/**/*.png
!tests/**/generated/*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Runtime
.anonymizer-sessions/
*.log

# Playwright MCP scratch output
.playwright-mcp/
*.png
!web/**/*.png
# Application icons are generated by desktop/make_icon.py and committed, so
# a build works from a fresh clone. A test keeps them from drifting.
!desktop/*.png

# Verified output files
output/

# Build output
dist/
build/
*.spec.bak

# Rust build output, and the WebView2 profile wry creates beside the exe
rust/target/
*.WebView2/
